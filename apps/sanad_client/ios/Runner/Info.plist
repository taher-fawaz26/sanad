<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sanad Client</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Sanad Client</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>GMSApiKey</key>
	<string>$(MAPS_API_KEY)</string>
	<!-- Location usage strings — required by permission_handler and Google Maps SDK -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sanad uses your location to show you nearby services and help you select a location on the map.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Sanad uses your location to show you nearby services and help you select a location on the map.</string>
	<!-- Camera / photo library — required to attach an image to an AI chat
	     message. -->
	<key>NSCameraUsageDescription</key>
	<string>Sanad uses the camera so you can take a photo to send to the assistant.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sanad needs access to your photos so you can attach them to a message for the assistant.</string>
	<!-- Microphone — required to record a voice note and to run live voice. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Sanad uses the microphone so you can record a voice message or talk to the assistant.</string>
	<!-- Speech recognition — a separate iOS grant from the microphone, needed
	     to turn dictation into text in the chat composer. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sanad uses speech recognition to turn what you say into a message you can edit before sending.</string>
	<!-- Face ID — required for the local biometric/device unlock gate. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Sanad uses Face ID to unlock the app and protect your account.</string>
	<!-- Custom-scheme deep-link fallback — works without domain
		 verification, useful for QA before Associated Domains /
		 apple-app-site-association is published. Universal Links
		 (the production path) are configured via Runner.entitlements,
		 not here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sanad.client.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sanadclient</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
