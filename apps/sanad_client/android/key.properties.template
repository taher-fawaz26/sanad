# Android Release Signing — Sand Client
# Copy this file to key.properties and fill in your keystore details.
# NEVER commit key.properties to source control.
#
# To generate a keystore:
#   keytool -genkey -v -keystore sand-client-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias sand-client
#
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=sand-client
storeFile=../sand-client-release.jks
