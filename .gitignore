# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
coverage/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# FVM Version Cache
.fvm/

# macOS finder metadata
.DS_Store
**/.DS_Store

# Google Maps API keys (never commit)
**/Secrets.xcconfig

# dart-define secrets: commit only the *.example.json templates, never the real files
**/dart_defines/*.json
!**/dart_defines/*.example.json

# stray `flutter analyze`/`flutter test` run logs left in package roots
flutter_[0-9][0-9].log

# stray Firebase CLI debug logs
firebase-debug.log

# Font Awesome Pro is a paid, licensed subscription (trysanad.us account).
# The vendored/configured font_awesome_flutter copy embeds Pro OTF fonts and
# icons.json metadata pulled from that account and must never be committed or
# pushed to any repository, public or private. See third_party/font_awesome_flutter/README.md
# for how each developer/CI regenerates it locally from their own Pro download.
third_party/font_awesome_flutter/

# Raw Font Awesome Pro desktop download — never commit under any path.
**/fontawesome-pro-*/

# IntelliJ / Android Studio project state — regenerated by `melos bootstrap`
# ("Generating IntelliJ IDE files") and otherwise per-developer/machine-specific.
# Exception: .idea/runConfigurations/*.xml are the shared Melos run/test
# configurations every developer (Windows or macOS) gets on clone — keep those.
.idea/*
!.idea/runConfigurations/
!.idea/runConfigurations/*.xml

melos_sanad.iml